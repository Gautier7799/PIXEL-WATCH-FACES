<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="com.google.android.permission.PROVIDE_BACKGROUND" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:label="My Watch Faces"
        android:supportsRtl="true"
        tools:targetApi="31">
        
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />
        <meta-data android:name="com.google.android.wearable.watchface.format" android:value="true" />

        <!-- الواجهة الأولى: المجال الحركي -->
        <service
            android:name="androidx.wear.watchface.WatchFaceService"
            android:exported="true"
            android:label="WFF Kinetic"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
                <category android:name="com.google.android.wearable.watchface.category.WATCH_FACE" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/watch_face_info" />
            <meta-data android:name="com.google.wear.watchface.format.resource" android:resource="@xml/watchface_kinetic" />
        </service>

        <!-- الواجهة الثانية: القرص اليومي -->
        <service
            android:name=".EverydayService"
            android:exported="true"
            android:label="WFF Everyday"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
                <category android:name="com.google.android.wearable.watchface.category.WATCH_FACE" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/watch_face_info" />
            <meta-data android:name="com.google.wear.watchface.format.resource" android:resource="@xml/watchface_everyday" />
        </service>

        <!-- الواجهة الثالثة: الكرونوغراف -->
        <service
            android:name=".ChronoService"
            android:exported="true"
            android:label="WFF Chrono"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
                <category android:name="com.google.android.wearable.watchface.category.WATCH_FACE" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/watch_face_info" />
            <meta-data android:name="com.google.wear.watchface.format.resource" android:resource="@xml/watchface_chrono" />
        </service>
    </application>
</manifest>
