<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Scene>
        <!-- خلفية سوداء للحفاظ على البطارية -->
        <Color value="#000000" />
        
        <!-- ساعة العقارب -->
        <AnalogClock x="0" y="0" width="450" height="450">
            <!-- عقرب الساعات (أبيض) -->
            <HourHand resource="@drawable/hour_hand" 
                      x="215" y="100" width="20" height="150" 
                      pivotX="10" pivotY="125" />
                      
            <!-- عقرب الدقائق (أخضر) -->
            <MinuteHand resource="@drawable/minute_hand" 
                        x="215" y="75" width="20" height="175" 
                        pivotX="10" pivotY="150" />
                        
            <!-- عقرب الثواني (أحمر) -->
            <SecondHand resource="@drawable/second_hand" 
                        x="220" y="50" width="10" height="200" 
                        pivotX="5" pivotY="175" />
        </AnalogClock>
    </Scene>
</WatchFace>
