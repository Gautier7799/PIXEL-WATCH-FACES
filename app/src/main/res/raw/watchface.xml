<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <Scene>
        <!-- 1. الخلفية المتموجة النظيفة -->
        <PartImage x="0" y="0" width="450" height="450">
            <Image resource="background" />
        </PartImage>
        
        <AnalogClock x="0" y="0" width="450" height="450">
            
            <!-- 2. عقرب الساعات (أبيض مفرغ - قصير) -->
            <HourHand x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5">
                <PartDraw x="0" y="0" width="450" height="450">
                    <!-- المستطيل المفرغ -->
                    <RoundRectangle x="217" y="110" width="16" height="115" cornerRadiusX="8" cornerRadiusY="8">
                        <Stroke color="#FFFFFF" thickness="4" />
                    </RoundRectangle>
                </PartDraw>
            </HourHand>
            
            <!-- 3. عقرب الدقائق (أبيض مفرغ - طويل) -->
            <MinuteHand x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5">
                <PartDraw x="0" y="0" width="450" height="450">
                    <!-- المستطيل المفرغ -->
                    <RoundRectangle x="217" y="50" width="16" height="175" cornerRadiusX="8" cornerRadiusY="8">
                        <Stroke color="#FFFFFF" thickness="4" />
                    </RoundRectangle>
                </PartDraw>
            </MinuteHand>
            
            <!-- 4. عقرب الثواني (أخضر رياضي مع دائرة في المنتصف) -->
            <SecondHand x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5">
                <PartDraw x="0" y="0" width="450" height="450">
                    <!-- الخط الأخضر -->
                    <Line startX="225" startY="50" endX="225" endY="260">
                        <Stroke color="#00FF55" thickness="3" />
                    </Line>
                    <!-- الدائرة الخضراء المفرغة في المركز -->
                    <Circle centerX="225" centerY="225" radius="10">
                        <Stroke color="#00FF55" thickness="4" />
                        <Fill color="#000000" />
                    </Circle>
                </PartDraw>
            </SecondHand>
            
        </AnalogClock>
    </Scene>
</WatchFace>
